# Every environment variable the code reads. Real values live in Vercel
# (Settings → Environment Variables); never commit them.

# Anthropic API key for the analyzers and the script generator.
ANTHROPIC_API_KEY=

# Upstash Redis. Added automatically (as KV_*) when the database is connected
# from the Vercel Marketplace. UPSTASH_REDIS_REST_* names are also accepted.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Stripe secret key for account acct_1MRh0gKjxEB5kBDn (Next Level Negotiation).
# Used to verify checkout sessions and to re-fetch webhook events.
STRIPE_SECRET_KEY=

# Admin page password. If unset, LEADS_EXPORT_TOKEN is used instead.
ADMIN_PASSWORD=
# Shared secret for the leads CSV: GET /api/leads?token=<this value>.
LEADS_EXPORT_TOKEN=

# Resend, for emailing buyers their script and alerting JobJenny about
# session purchases. The sending domain (nextlevelnegotiation.com) must be
# verified in Resend.
RESEND_API_KEY=
# Optional overrides (defaults shown).
# SESSION_ALERT_TO=info@jobjenny.com
# SESSION_ALERT_FROM=NLN Alerts <alerts@nextlevelnegotiation.com>
# SCRIPT_EMAIL_FROM=Next Level Negotiation <scripts@nextlevelnegotiation.com>

# TEMPORARY: set to "true" in production to allow session_id=test_skip_payment
# (always allowed on preview deployments). Delete when testing ends.
# ALLOW_TEST_BYPASS=true

# Only for scripts/create-session-payment-links.js, run locally.
# BOOKING_DOMAIN=www.jobofferanalyzer.com

# VERCEL and VERCEL_ENV are set by Vercel itself.
